  "figures": {
    "00a_regbus": {
      "edges": [
        {
          "id": "E01",
          "source": "N01",
          "target": "N02",
          "label": "AXI4 请求 AW/W/AR 向 Xbar；B/R 响应及 ready 反向。默认数据64、地址48。"
        },
        {
          "id": "E02",
          "source": "N02",
          "target": "N03",
          "label": "AxiOut.reg_demux：Xbar 选中的 AXI 请求/响应，进入原子适配、cut 和桥。"
        },
        {
          "id": "E03",
          "source": "N03",
          "target": "N04",
          "label": "reg_in_req / reg_in_rsp：Regbus addr/write/wdata[31:0]/wstrb[3:0]/valid，返回 rdata/error/ready。"
        },
        {
          "id": "E04",
          "source": "N03",
          "target": "N05",
          "label": "reg_in_req.addr：地址送 i_reg_demux_decode，以 RegMap 做范围译码。"
        },
        {
          "id": "E05",
          "source": "N05",
          "target": "N04",
          "label": "reg_select：地址译码选中的目标索引；未命中使用默认错误端口。"
        },
        {
          "id": "E06",
          "source": "N04",
          "target": "N06",
          "label": "reg_out_req / reg_out_rsp：被选片内目标的 Regbus 请求及返回。"
        },
        {
          "id": "E07",
          "source": "N04",
          "target": "N07",
          "label": "错误端口 Regbus 请求/响应；未命中时 ready=1、error=1。"
        },
        {
          "id": "E08",
          "source": "N04",
          "target": "N08",
          "label": "扩展端口 reg_ext_slv_req_o[k] / reg_ext_slv_rsp_i[k]；配置产生后才有可用目标。"
        },
        {
          "id": "E09",
          "source": "N08",
          "target": "N09",
          "label": "规划：外部 Regbus 请求/响应；同域直连，异域新增 reg_cdc。"
        }
      ],
      "corrections": [
        {
          "kind": "note",
          "message": "N08/N09 都须标默认端口数0/规划；现有同域桥与拟新增CDC分开；64/32/48来自DefaultCfg而非接口固定限制。"
        }
      ]
    },
    "00b_ip_contract": {
      "edges": [
        {
          "id": "E01",
          "source": "P01",
          "target": "N01",
          "label": "建议 Regbus 端点请求：addr/write/wdata/wstrb/valid；完整地址是否减 BASE 由封装定义。"
        },
        {
          "id": "E02",
          "source": "N01",
          "target": "N02",
          "label": "建议写路径：地址命中、权限和 wstrb 合法且 valid&ready 后产生字段写使能/写数据。"
        },
        {
          "id": "E03",
          "source": "N02",
          "target": "N05",
          "label": "建议 START 提交及整组配置快照；工作逻辑另定义 accept/busy 协议。"
        },
        {
          "id": "E04",
          "source": "N05",
          "target": "N03",
          "label": "建议工作状态 busy/done/error 回到可读状态与事件锁存。"
        },
        {
          "id": "E05",
          "source": "N01",
          "target": "N04",
          "label": "建议读地址/访问属性译码，选择 rdata 并判定错误及完成条件。"
        },
        {
          "id": "E06",
          "source": "N02",
          "target": "N04",
          "label": "建议配置寄存器当前值送读选择器。"
        },
        {
          "id": "E07",
          "source": "N03",
          "target": "N04",
          "label": "建议状态/事件寄存器当前值送读选择器。"
        },
        {
          "id": "E08",
          "source": "P02",
          "target": "N03",
          "label": "建议清除使能来自地址/写握手译码，W1C 对应 wdata 中写1且 wstrb 选中的事件位。"
        },
        {
          "id": "E09",
          "source": "N04",
          "target": "P03",
          "label": "建议 Regbus 返回：rdata/error/ready；应答配置访问，非等待整个运算完成。"
        }
      ],
      "corrections": [
        {
          "kind": "edge",
          "id": "E08",
          "source": "N01",
          "target": "N03",
          "message": "W1C箭头起点不应悬空为真实外部端口P02；清除使能从地址/合法写握手逻辑来。建议改成N01→N03，P02删除或仅作注释。"
        },
        {
          "kind": "note",
          "message": "整图是建议契约，所有具体字段名均示意；busy/done/error为功能角色，不是已有NPU寄存器。"
        }
      ]
    },
    "01_uart": {
      "edges": [
        {
          "id": "E01",
          "source": "N01",
          "target": "N02",
          "label": "APB 请求 PSEL/PENABLE/PWRITE/PADDR/PWDATA；PRDATA/PREADY/PSLVERR 返回。PADDR=addr[4:2]。"
        },
        {
          "id": "E02",
          "source": "N02",
          "target": "N03",
          "label": "iBaudgenDiv={iDLM,iDLL}：分频寄存器给 uart_baudgen.DIVIDER。"
        },
        {
          "id": "E03",
          "source": "N02",
          "target": "N04",
          "label": "PWDATA[7:0] 与 iTXFIFOWrite：合法 THR 写入 TX FIFO；复位/清空由 FCR 控制。"
        },
        {
          "id": "E04",
          "source": "N04",
          "target": "N05",
          "label": "iTXFIFOQ[7:0] 经发送控制过程锁存 iTSR，再送 UART_TX.DIN；iTXFIFORead 消耗队头。"
        },
        {
          "id": "E05",
          "source": "N05",
          "target": "P01",
          "label": "iSOUT 到 SOUT/uart_tx_o：串行输出位，调制解调/回环选择属于 UART 包装逻辑。"
        },
        {
          "id": "E06",
          "source": "P02",
          "target": "N07",
          "label": "uart_rx_i/SIN 经输入同步与回环选择成为 iSIN，送 UART_RX.SIN。"
        },
        {
          "id": "E07",
          "source": "N07",
          "target": "N06",
          "label": "iRXData[7:0]、iRXPE/iRXFE/iRXBI 与 iRXFinished：RX 控制过程产生 iRXFIFOD[10:0]/iRXFIFOWrite。"
        },
        {
          "id": "E08",
          "source": "N06",
          "target": "N02",
          "label": "iRXFIFOQ[7:0]→iRBR→PRDATA；RBR 读产生反向 iRXFIFORead 出队动作。"
        },
        {
          "id": "E09",
          "source": "N03",
          "target": "N05",
          "label": "iBaudtick16x 经 UART_BG2 分频得到 iBaudtick2x，作为 UART_TX.TXCLK 的使能节拍。"
        },
        {
          "id": "E10",
          "source": "N03",
          "target": "N07",
          "label": "波特率/边沿逻辑产生 iRCLK，送 UART_RX.RXCLK；不是另一个寄存器时钟域。"
        },
        {
          "id": "E11",
          "source": "N06",
          "target": "N08",
          "label": "接收水位/错误/超时派生 iRDAInterrupt、iLSR[4:0]、iCharTimeout，送 UART_IIC。"
        },
        {
          "id": "E12",
          "source": "N02",
          "target": "N08",
          "label": "iIER[3:0]、iMCR_AFE、iMSR[3:0] 等配置/状态送 UART_IIC；iIIR[3:0] 返回寄存器读路径。"
        },
        {
          "id": "E13",
          "source": "N08",
          "target": "P03",
          "label": "UART_IIC.INT→intr_o→intr.intn.uart；设备事件再进入 SoC IRQ 路径。"
        }
      ],
      "corrections": [
        {
          "kind": "node",
          "id": "N05",
          "message": "可标“uart_transmitter + TX控制”；TX FIFO经顶层iTSR保持寄存器后到DIN，非实例直接data连线。"
        },
        {
          "kind": "edge",
          "id": "E12",
          "both": true,
          "message": "加入iIIR返回APB读路径，IER/MSR等正向。"
        },
        {
          "kind": "add_edge",
          "source": "N04",
          "target": "N08",
          "label": "TX空派生iTHRInterrupt→UART_IIC.THI",
          "message": "E11只可解释接收相关中断，发送中断应单独补线或配对端口。"
        },
        {
          "kind": "note",
          "message": "RX引脚到receiver包含输入同步/回环选择；baudgen方框需解释为包含后续tick分频/边沿逻辑。"
        }
      ]
    },
    "02_i2c": {
      "edges": [
        {
          "id": "E01",
          "source": "N01",
          "target": "N02",
          "label": "reg2hw.fdata→fmt_fifo_wdata[12:0]/fmt_fifo_wvalid：8-bit 字节+5-bit 事务标志。"
        },
        {
          "id": "E02",
          "source": "N02",
          "target": "N04",
          "label": "fmt_byte/五个 fmt_flag 与 fmt_fifo_rvalid；FSM 以 fmt_fifo_rready 消耗命令。"
        },
        {
          "id": "E03",
          "source": "N04",
          "target": "N03",
          "label": "rx_fifo_wdata[7:0]/rx_fifo_wvalid：FSM 采样接收字节，写入 Host RX FIFO。"
        },
        {
          "id": "E04",
          "source": "N03",
          "target": "N01",
          "label": "rx_fifo_rdata→hw2reg.rdata；读请求经 reg2hw.rdata.re 产生 FIFO 消耗。"
        },
        {
          "id": "E05",
          "source": "N04",
          "target": "N05",
          "label": "FSM scl_out_fsm/sda_out_fsm 输出，scl_sync/sda_sync 反馈；core 加 override/采样和 OE 后连接 cio_scl/sda_*。"
        },
        {
          "id": "E06",
          "source": "N06",
          "target": "N04",
          "label": "tx_fifo_rdata[7:0]/rvalid 与 FSM 反向 rready：Target 发送字节。"
        },
        {
          "id": "E07",
          "source": "N04",
          "target": "N07",
          "label": "acq_fifo_wdata[9:0]/wvalid：Target 接收内容与事务标志；还有 FIFO 深度/当前项反馈到 FSM。"
        },
        {
          "id": "E08",
          "source": "N01",
          "target": "N04",
          "label": "host_enable/target_enable、thigh/tlow/建立保持/超时等字段控制 FSM；FIFO reset 另接各队列，不是经过 FSM。"
        },
        {
          "id": "E09",
          "source": "N04",
          "target": "N08",
          "label": "FSM 的 event_nak/event_cmd_complete/event_* 送中断逻辑；水位/溢出等另来自 FIFO 周边。"
        },
        {
          "id": "E10",
          "source": "N01",
          "target": "N08",
          "label": "reg2hw.intr_enable/intr_test/intr_state 送 prim_intr_hw；hw2reg.intr_state.d/de 反向更新寄存器。"
        }
      ],
      "corrections": [
        {
          "kind": "add_edge",
          "source": "N01",
          "target": "N06",
          "label": "reg2hw.txdata→tx_fifo_wdata/wvalid；Target软件填充"
        },
        {
          "kind": "add_edge",
          "source": "N07",
          "target": "N01",
          "label": "acq_fifo_rdata→hw2reg.acqdata；读消费由reg2hw返回"
        },
        {
          "kind": "edge",
          "id": "E10",
          "both": true,
          "message": "中断状态hw2reg回写也是该组关系，勿只标enable/test单方向。"
        },
        {
          "kind": "note",
          "message": "E08的FIFO reset从reg2hw直接到各FIFO，不经过FSM。N08还收FIFO派生事件，建议标“FSM/FIFO事件”，避免把15路全归FSM。N05包含同步/override/IO控制，并非FSM直接处理PAD OE。"
        }
      ]
    },
    "03_spi": {
      "edges": [
        {
          "id": "E01",
          "source": "N01",
          "target": "N02",
          "label": "command/command_valid 进入命令队列，command_busy/qd/error_busy 回到状态与错误逻辑。"
        },
        {
          "id": "E02",
          "source": "N02",
          "target": "N03",
          "label": "core_command/core_command_valid 向 FSM；core_command_ready 反向接受命令。"
        },
        {
          "id": "E03",
          "source": "N01",
          "target": "N04",
          "label": "fifo_win_h2d[RX/TX] 与 fifo_win_d2h[RX/TX]：reg_top 解码后的两个 Regbus 窗口。"
        },
        {
          "id": "E04",
          "source": "N04",
          "target": "N05",
          "label": "tx_data[31:0]/tx_be[3:0]/tx_valid_checked 入 TX FIFO；tx_ready 用于写溢出检查，不无限延迟 MMIO。"
        },
        {
          "id": "E05",
          "source": "N06",
