{
  "labels": [
    {
      "x": 40,
      "y": 49,
      "text": "07  IRQ Router：每条源中断对应一个目标位掩码",
      "size": 32,
      "anchor": "start"
    },
    {
      "x": 202.5,
      "y": 230.0,
      "text": "1  intr 源向量",
      "size": 24,
      "anchor": "middle"
    },
    {
      "x": 202.5,
      "y": 262.0,
      "text": "片内外设 IRQ",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 202.5,
      "y": 294.0,
      "text": "外部 IRQ 经 sync",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 202.5,
      "y": 326.0,
      "text": "源 0 固定为 0",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 650.0,
      "y": 243.5,
      "text": "2  irqs_cloned",
      "size": 24,
      "anchor": "middle"
    },
    {
      "x": 650.0,
      "y": 275.5,
      "text": "每个目标一份源向量",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 650.0,
      "y": 307.5,
      "text": "组合逻辑复制",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1142.5,
      "y": 230.0,
      "text": "3  按位 AND",
      "size": 24,
      "anchor": "middle"
    },
    {
      "x": 1142.5,
      "y": 262.0,
      "text": "out[target][source]",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1142.5,
      "y": 294.0,
      "text": "= src[source]",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1142.5,
      "y": 326.0,
      "text": "& mask[source][target]",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1435,
      "y": 231,
      "text": "target 0 → PLIC",
      "size": 24,
      "anchor": "start"
    },
    {
      "x": 1435,
      "y": 281,
      "text": "target 1… → 各 hart CLIC",
      "size": 24,
      "anchor": "start"
    },
    {
      "x": 1435,
      "y": 331,
      "text": "后续 target → 外部输出",
      "size": 24,
      "anchor": "start"
    },
    {
      "x": 685.0,
      "y": 652.5,
      "text": "4  irq_router_reg_top × 源",
      "size": 24,
      "anchor": "middle"
    },
    {
      "x": 685.0,
      "y": 684.5,
      "text": "每源一个 IRQ_TARGET_MASK",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 685.0,
      "y": 716.5,
      "text": "地址低位 addr[15:2] 选择源",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 685.0,
      "y": 748.5,
      "text": "复位 mask = 1：仅 target 0",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 455,
      "y": 548,
      "text": "Regbus 请求 / 响应",
      "size": 24,
      "anchor": "start"
    },
    {
      "x": 1170,
      "y": 536,
      "text": "掩码重排为目标 × 源",
      "size": 23,
      "anchor": "start"
    },
    {
      "x": 55,
      "y": 870,
      "text": "Cfg.IrqRouter = 0 时：绕过掩码，原始源向量复制给各目标；模块没有 pending 或优先级队列。",
      "size": 24,
      "anchor": "start"
    },
    {
      "x": 130,
      "y": 946,
      "text": "数据 / 请求；双箭头含返回",
      "size": 22,
      "anchor": "start"
    },
    {
      "x": 667,
      "y": 946,
      "text": "配置 / 控制（标注 IRQ、使能时按标签）",
      "size": 22,
      "anchor": "start"
    },
    {
      "x": 1270,
      "y": 946,
      "text": "编号与正文逐块对应",
      "size": 22,
      "anchor": "start"
    }
  ],
