{
  "labels": [
    {
      "x": 40,
      "y": 49,
      "text": "15  CVA6 Trap：异步中断与同步异常在提交路径汇合",
      "size": 32,
      "anchor": "start"
    },
    {
      "x": 205.0,
      "y": 215.0,
      "text": "1  平台中断输入",
      "size": 24,
      "anchor": "middle"
    },
    {
      "x": 205.0,
      "y": 247.0,
      "text": "PLIC：irq_i（M / S）",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 205.0,
      "y": 279.0,
      "text": "CLINT：time_irq_i / ipi_i",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 205.0,
      "y": 311.0,
      "text": "可选 CLIC 握手",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 677.5,
      "y": 199.0,
      "text": "2  csr_regfile",
      "size": 24,
      "anchor": "middle"
    },
    {
      "x": 677.5,
      "y": 231.0,
      "text": "pending / enable / 委托",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 677.5,
      "y": 263.0,
      "text": "mip / mie / mstatus …",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 677.5,
      "y": 295.0,
      "text": "trap 状态：epc / cause / tval",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 677.5,
      "y": 327.0,
      "text": "trap_vector_base / eret",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1205.0,
      "y": 199.0,
      "text": "3  decoder / id_stage",
      "size": 24,
      "anchor": "middle"
    },
    {
      "x": 1205.0,
      "y": 231.0,
      "text": "结合特权级与 IRQ 控制",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1205.0,
      "y": 263.0,
      "text": "选出可接受的中断",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1205.0,
      "y": 295.0,
      "text": "或生成译码异常",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1205.0,
      "y": 327.0,
      "text": "写入指令的 ex 信息",
      "size": 22,
      "anchor": "middle"
    },
    {
