    },
    {
      "x": 635.0,
      "y": 630.0,
      "text": "6  controller + frontend",
      "size": 24,
      "anchor": "middle"
    },
    {
      "x": 635.0,
      "y": 662.0,
      "text": "flush 错误路径流水线",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 635.0,
      "y": 694.0,
      "text": "PC 转向 trap 入口",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 635.0,
      "y": 726.0,
      "text": "xRET 恢复返回 PC",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 50,
      "y": 626,
      "text": "CPU 开始执行处理程序",
      "size": 23,
      "anchor": "start"
    },
    {
      "x": 45,
      "y": 865,
      "text": "图中软件处理程序不在硬件中：保存现场、处理设备 / 控制器、恢复现场，再执行返回指令。",
      "size": 24,
      "anchor": "start"
    },
    {
      "x": 130,
      "y": 946,
      "text": "数据 / 请求；双箭头含返回",
