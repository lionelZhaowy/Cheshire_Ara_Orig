      "y": 231.0,
      "text": "4  scoreboard",
      "size": 24,
      "anchor": "middle"
    },
    {
      "x": 1620.0,
      "y": 263.0,
      "text": "指令与结果关联",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1620.0,
      "y": 295.0,
      "text": "ex 随指令保存",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1617.5,
      "y": 615.0,
      "text": "5  commit_stage",
      "size": 24,
      "anchor": "middle"
    },
    {
      "x": 1617.5,
      "y": 647.0,
      "text": "按提交顺序选异常",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1617.5,
      "y": 679.0,
      "text": "阻止错误指令提交",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1617.5,
      "y": 711.0,
      "text": "ex_commit → CSR",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1145.0,
      "y": 633.5,
      "text": "执行 / 访存异常",
      "size": 24,
      "anchor": "middle"
    },
    {
      "x": 1145.0,
      "y": 665.5,
      "text": "非法操作 / 访问故障等",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1145.0,
      "y": 697.5,
      "text": "结果携带 exception_t",
