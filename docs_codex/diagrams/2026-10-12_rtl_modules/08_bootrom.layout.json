{
  "labels": [
    {
      "x": 40,
      "y": 49,
      "text": "08  BootROM：组合 ROM 内容与 Regbus 应答延迟",
      "size": 32,
      "anchor": "start"
    },
    {
      "x": 380,
      "y": 185,
      "text": "Cfg.Bootrom 生成分支；clk_i / rst_ni",
      "size": 23,
      "anchor": "start"
    },
    {
      "x": 45,
      "y": 280,
      "text": "Regbus 32",
      "size": 25,
      "anchor": "start"
    },
    {
      "x": 577.5,
      "y": 271.5,
      "text": "1  reg_to_mem",
      "size": 24,
      "anchor": "middle"
    },
    {
      "x": 577.5,
      "y": 303.5,
      "text": "地址截为 16-bit",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 577.5,
      "y": 335.5,
      "text": "req / we / addr",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 577.5,
      "y": 367.5,
      "text": "gnt = req",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 577.5,
      "y": 399.5,
      "text": "rvalid / rerror 返回",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1100.0,
      "y": 261.5,
      "text": "2  cheshire_bootrom",
      "size": 24,
      "anchor": "middle"
    },
    {
      "x": 1100.0,
      "y": 293.5,
      "text": "word = addr / 4",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1100.0,
      "y": 325.5,
      "text": "case(word) → data[31:0]",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1100.0,
      "y": 357.5,
      "text": "当前生成内容：2048 words",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1100.0,
      "y": 389.5,
      "text": "组合查表；clk / rst 未用",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1562.5,
      "y": 277.5,
      "text": "3  FF 延迟对齐",
      "size": 24,
      "anchor": "middle"
    },
    {
      "x": 1562.5,
      "y": 309.5,
      "text": "data_q ← data",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1562.5,
      "y": 341.5,
      "text": "req_q ← req",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1562.5,
      "y": 373.5,
      "text": "we_q ← we",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1020,
      "y": 468,
      "text": "req / we 同步延迟",
      "size": 22,
      "anchor": "start"
    },
    {
      "x": 835,
      "y": 575,
      "text": "rdata = data_q；rvalid = req_q；rerror = we_q",
      "size": 23,
      "anchor": "start"
    },
    {
      "x": 60,
      "y": 795,
      "text": "软件源 .S / .c → 链接与 ROM 生成脚本 → cheshire_bootrom.sv 常量内容",
      "size": 26,
      "anchor": "start"
    },
    {
      "x": 60,
      "y": 851,
      "text": "写访问返回错误；16-bit 接口窗口不等于 64 KiB 唯一 ROM 内容。",
      "size": 24,
      "anchor": "start"
    },
    {
      "x": 130,
      "y": 946,
      "text": "数据 / 请求；双箭头含返回",
      "size": 22,
      "anchor": "start"
    },
    {
      "x": 667,
      "y": 946,
      "text": "配置 / 控制（标注 IRQ、使能时按标签）",
      "size": 22,
      "anchor": "start"
    },
    {
      "x": 1270,
      "y": 946,
      "text": "编号与正文逐块对应",
      "size": 22,
      "anchor": "start"
    }
  ],
