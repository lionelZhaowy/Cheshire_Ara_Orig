    },
    {
      "x": 195.0,
      "y": 428.0,
      "text": "addr / write / wstrb",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 195.0,
      "y": 460.0,
      "text": "wdata / valid",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 695.0,
      "y": 247.5,
      "text": "1  地址与访问译码",
      "size": 24,
      "anchor": "middle"
    },
    {
      "x": 695.0,
      "y": 279.5,
      "text": "cheshire_reg_top",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 695.0,
      "y": 311.5,
      "text": "reg_we / reg_re",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 695.0,
      "y": 343.5,
      "text": "字节写使能 / 未命中错误",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1407.5,
      "y": 213.5,
      "text": "2  scratch[0…15]",
      "size": 24,
      "anchor": "middle"
    },
    {
      "x": 1407.5,
      "y": 245.5,
      "text": "prim_subreg：16 × 32-bit RW",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1407.5,
      "y": 277.5,
      "text": "保存软件数据；复位为 0；不是 SRAM",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1407.5,
      "y": 501.5,
      "text": "3  硬件只读字段",
      "size": 24,
      "anchor": "middle"
    },
    {
      "x": 1407.5,
      "y": 533.5,
      "text": "boot_mode_i；RtcFreq；PlatformRom",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1407.5,
      "y": 565.5,
      "text": "NumIntHarts；HW_FEATURES；LLC_SIZE",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1407.5,
      "y": 597.5,
      "text": "VGA RGB 位宽",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 1407.5,
      "y": 629.5,
      "text": "来自 SoC 的 hw2reg 连线",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 695.0,
      "y": 683.5,
      "text": "4  读回选择 / 响应",
      "size": 24,
      "anchor": "middle"
    },
    {
      "x": 695.0,
      "y": 715.5,
      "text": "rdata = 地址选中值",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 695.0,
      "y": 747.5,
      "text": "ready = 1；error = 非法访问",
      "size": 22,
      "anchor": "middle"
    },
    {
      "x": 45,
      "y": 793,
      "text": "rdata / error / ready",
      "size": 24,
      "anchor": "start"
    },
    {
      "x": 60,
      "y": 865,
      "text": "功能位描述当前综合配置，不是动态电源开关，也不是 PLL 或 DDR 初始化控制器。",
      "size": 24,
      "anchor": "start"
    },
    {
      "x": 130,
      "y": 946,
      "text": "数据 / 请求；双箭头含返回",
      "size": 22,
      "anchor": "start"
    },
    {
      "x": 667,
      "y": 946,
      "text": "配置 / 控制（标注 IRQ、使能时按标签）",
      "size": 22,
      "anchor": "start"
    },
    {
      "x": 1270,
      "y": 946,
      "text": "编号与正文逐块对应",
      "size": 22,
      "anchor": "start"
    }
